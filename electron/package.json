{
  "name": "calliope-shell",
  "productName": "Calliope",
  "version": "1.0.0",
  "private": true,
  "description": "Electron shell for the Calliope local story-to-video studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir",
    "build:web": "cd ../calliope-web && npm run build",
    "build:backend": "cd ../calliope-backend && .venv/Scripts/python.exe -m PyInstaller calliope.spec --noconfirm",
    "build:all": "npm run build:web && npm run build:backend && npm run dist",
    "zip": "powershell -NoProfile -Command \"Compress-Archive -Path 'dist/win-unpacked' -DestinationPath 'dist/Calliope-win-x64.zip' -Force\""
  },
  "build": {
    "appId": "com.calliope.app",
    "productName": "Calliope",
    "asar": true,
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../calliope-backend/dist/calliope-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**",
          "!data",
          "!calliope_config.json"
        ]
      }
    ],
    "win": {
      "target": [
        "dir"
      ]
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
